<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>1.0.1</Version>
    <Authors>hazre</Authors>
    <TargetFramework>net10.0</TargetFramework>
    <RepositoryUrl>https://github.com/hazre/ResoniteLinkPlus</RepositoryUrl>
    <PackageId>dev.hazre.resonitelinkplus</PackageId>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DebugType>embedded</DebugType>
    <NoWarn>$(NoWarn);HookGen0004;CS0436</NoWarn>
    <CopyToPlugins>true</CopyToPlugins>
    <ThunderstorePackable>true</ThunderstorePackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.AutoPlugin" Version="2.1.0" PrivateAssets="all" />
    <PackageReference Include="ResoniteModding.BepInExResoniteShim" Version="0.9.*" PrivateAssets="all" />
    <PackageReference Include="ResoniteModding.BepisLocaleLoader" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="MonoDetour.HookGen" Version="0.7.*" PrivateAssets="all" />
    <PackageReference Include="MonoDetour" Version="[*,2.0)" />
    <PackageReference Include="Krafs.Publicizer" Version="2.3.2" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  
  <ItemGroup Condition="!Exists('$(GamePath)')">
    <PackageReference Include="Resonite.GameLibs" Version="*" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Publicize Include="FrooxEngine" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Locale\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(GamePath)')">
    <Reference Include="FrooxEngine" HintPath="$(GamePath)FrooxEngine.dll" Private="false" />
    <Reference Include="FrooxEngine.Store" HintPath="$(GamePath)FrooxEngine.Store.dll" Private="false" />
    <Reference Include="Elements.Core" HintPath="$(GamePath)Elements.Core.dll" Private="false" />
    <Reference Include="Elements.Data" HintPath="$(GamePath)Elements.Data.dll" Private="false" />
    <Reference Include="Elements.Assets" HintPath="$(GamePath)Elements.Assets.dll" Private="false" />
  </ItemGroup>
</Project>
